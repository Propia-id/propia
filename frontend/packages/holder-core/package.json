{
  "name": "@sovrahq/holder-core",
  "version": "0.1.1",
  "type": "module",
  "description": "Platform-agnostic core for a Sovra credential holder/wallet: SD-JWT VC handling, OpenID4VCI/VP protocol flows, credential storage, and P-256/EIP-712 crypto utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdaclass/sovra.git",
    "directory": "frontend/packages/holder-core"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    }
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@sd-jwt/core": "^0.9.0",
    "@sd-jwt/decode": "^0.9.0",
    "axios": "^1.7.0",
    "zustand": "^5.0.0"
  }
}
