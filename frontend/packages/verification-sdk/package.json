{
  "name": "@sovrahq/verification-sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "Verify Sovra SD-JWT VC presentations and signed documents against the on-chain DID, issuer and signature registries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdaclass/sovra.git",
    "directory": "frontend/packages/verification-sdk"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@sovrahq/holder-core": "workspace:*"
  },
  "devDependencies": {
    "@animo-id/mdoc": "0.5.2"
  }
}
