# ============================================================================
# Sovra Backend Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# ============================================================================

# --- Server ---
# PORT=4000                          # Optional. HTTP port (default: 4000)
# PHX_SERVER=true                    # Optional. Set to enable Phoenix server in releases

# --- Google OAuth ---
GOOGLE_CLIENT_ID=                    # Required in prod. Google OAuth client ID
GOOGLE_CLIENT_SECRET=                # Required in prod. Google OAuth client secret
GOOGLE_REDIRECT_URI=                 # Required in prod. OAuth callback URL
# GOOGLE_IOS_CLIENT_ID=              # Optional. iOS app client ID for ID token verification
# GOOGLE_ANDROID_CLIENT_ID=          # Optional. Android app client ID for ID token verification
# GOOGLE_WEB_CLIENT_ID=              # Optional. Web app client ID for ID token verification

# --- Secrets ---
SECRET_KEY_BASE=                     # Required in prod. Phoenix secret (generate: mix phx.gen.secret)
GUARDIAN_SESSION_SECRET=             # Required in prod. Session signing secret (min 32 bytes)
STORED_KEYS_ENCRYPTION_KEY=          # Required in prod. At-rest key for webhook HMAC secrets (generate: openssl rand -base64 32)

# --- Database (prod) ---
DATABASE_URL=                        # Required in prod. e.g. ecto://USER:PASS@HOST/DATABASE
# POOL_SIZE=10                       # Optional. Ecto connection pool size (default: 10)
# ECTO_IPV6=true                     # Optional. Enable IPv6 for database connections

# --- Phoenix ---
# PHX_HOST=example.com               # Optional. Production hostname (default: example.com)
# DNS_CLUSTER_QUERY=                 # Optional. DNS cluster query for distributed Erlang

# --- Ethereum / L2 ---
# The on-chain relayer signs via one of two backends:
#   - local: set ADMIN_PRIVATE_KEY (dev/test/local, in-process signing).
#   - kms:   leave ADMIN_PRIVATE_KEY unset; on-chain then signs through the
#            signer service's secp256k1 relayer key (prod). Requires SIGNER_URL +
#            DID_REGISTRY_ADDRESS, and RELAYER_KMS_KEY_ID on the signer node.
L2_RPC_URL=http://127.0.0.1:1729    # Optional. L2 RPC endpoint (default: http://127.0.0.1:1729)
ADMIN_PRIVATE_KEY=                   # Optional (local relayer). Omit to use the KMS relayer
DID_REGISTRY_ADDRESS=                # Required for on-chain ops. DID Registry contract address
ISSUER_REGISTRY_ADDRESS=             # Required for on-chain ops. Issuer Registry contract address
REVOCATION_REGISTRY_ADDRESS=         # Optional. Revocation Registry contract address (enables on-chain revocation)

# --- Issuer ---
# ISSUER_BASE_URL=http://localhost:4000  # Optional. Issuer service base URL (default: http://localhost:4000)

# --- Key Store (AWS KMS via the signer service) ---
# In prod the key store (KmsKeyStore) signs P-256 workspace keys by calling the
# dedicated signer service (SERVICE=signer) over Tailscale. The API node holds
# NO AWS credentials — only the signer URL + shared bearer token.
SIGNER_URL=                          # Required in prod. Signer base URL (e.g. http://sovra-signer:4001)
SIGNER_TOKEN=                        # Required in prod. Shared bearer token for the signer RPC

# --- Signer service (only the SERVICE=signer box) ---
# SERVICE=signer                     # Boots the slim KMS signer tree (no DB / endpoint)
# AWS_REGION=us-east-1               # Required (SERVICE=signer). Region of the KMS keys
# SIGNER_PORT=4001                   # Optional. Signer HTTP port (default: 4001)
# SIGNER_TOKEN=                      # Required (SERVICE=signer). Must match the API node's token
# RELAYER_KMS_KEY_ID=                # Optional (SERVICE=signer). secp256k1 KMS key for on-chain signing
# AWS credentials come from the EC2 instance role via IMDS — no static keys.
