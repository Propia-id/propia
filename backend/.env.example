# ============================================================================
# Sovra Backend Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# ============================================================================

# --- Server ---
# PORT=4000                          # Optional. HTTP port (default: 4000)
# PHX_SERVER=true                    # Optional. Set to enable Phoenix server in releases

# --- Google OAuth ---
GOOGLE_CLIENT_ID=                    # Required in prod. Google OAuth client ID
GOOGLE_CLIENT_SECRET=                # Required in prod. Google OAuth client secret
GOOGLE_REDIRECT_URI=                 # Required in prod. OAuth callback URL
# GOOGLE_IOS_CLIENT_ID=              # Optional. iOS app client ID for ID token verification
# GOOGLE_ANDROID_CLIENT_ID=          # Optional. Android app client ID for ID token verification
# GOOGLE_WEB_CLIENT_ID=              # Optional. Web app client ID for ID token verification

# --- Secrets ---
SECRET_KEY_BASE=                     # Required in prod. Phoenix secret (generate: mix phx.gen.secret)
GUARDIAN_SESSION_SECRET=             # Required in prod. Session signing secret (min 32 bytes)

# --- Database (prod) ---
DATABASE_URL=                        # Required in prod. e.g. ecto://USER:PASS@HOST/DATABASE
# POOL_SIZE=10                       # Optional. Ecto connection pool size (default: 10)
# ECTO_IPV6=true                     # Optional. Enable IPv6 for database connections

# --- Phoenix ---
# PHX_HOST=example.com               # Optional. Production hostname (default: example.com)
# DNS_CLUSTER_QUERY=                 # Optional. DNS cluster query for distributed Erlang

# --- Ethereum / L2 ---
L2_RPC_URL=http://127.0.0.1:1729    # Optional. L2 RPC endpoint (default: http://127.0.0.1:1729)
ADMIN_PRIVATE_KEY=                   # Optional. Admin wallet private key. If set, enables on-chain operations
DID_REGISTRY_ADDRESS=                # Required if ADMIN_PRIVATE_KEY is set. DID Registry contract address
ISSUER_REGISTRY_ADDRESS=             # Required if ADMIN_PRIVATE_KEY is set. Issuer Registry contract address
REVOCATION_REGISTRY_ADDRESS=         # Optional. Revocation Registry contract address (enables on-chain revocation)

# --- Issuer ---
# ISSUER_BASE_URL=http://localhost:4000  # Optional. Issuer service base URL (default: http://localhost:4000)

# --- Key Store (OpenBao/Vault Transit) ---
VAULT_ADDR=                          # Required in prod. OpenBao address (e.g. http://127.0.0.1:8200)
VAULT_TOKEN=                         # Required in prod. OpenBao authentication token
# VAULT_TRANSIT_MOUNT=transit        # Optional. Transit engine mount path (default: transit)
